{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "core_question", "thesis", "audience_start_state", "audience_end_state", "master_keycut_sequence_number", "style_bible", "sequences", "continuity_assets", "rejected_borderline_candidates"],
  "$defs": {
    "styleBible": {
      "type": "object", "additionalProperties": false,
      "required": ["preset_id", "medium_and_rendering", "palette", "lighting", "camera_and_depth", "texture_and_detail", "character_rendering", "environment_rendering", "composition_rules", "forbidden_variations"],
      "properties": {
        "preset_id": {"type": "string", "enum": ["editorial_illustration", "cinematic_realism", "graphic_explainer"]},
        "medium_and_rendering": {"type": "string", "minLength": 1},
        "palette": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1}},
        "lighting": {"type": "string", "minLength": 1}, "camera_and_depth": {"type": "string", "minLength": 1},
        "texture_and_detail": {"type": "string", "minLength": 1}, "character_rendering": {"type": "string", "minLength": 1},
        "environment_rendering": {"type": "string", "minLength": 1},
        "composition_rules": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1}},
        "forbidden_variations": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1}}
      }
    },
    "keycutDna": {
      "type": "object", "additionalProperties": false,
      "required": ["story_meaning", "composition_anchor", "palette_anchor", "lighting_anchor", "symbol_anchor", "must_inherit", "must_not_copy"],
      "properties": {
        "story_meaning": {"type": "string", "minLength": 1}, "composition_anchor": {"type": "string", "minLength": 1},
        "palette_anchor": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "lighting_anchor": {"type": "string", "minLength": 1}, "symbol_anchor": {"type": "array", "items": {"type": "string"}},
        "must_inherit": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "must_not_copy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["source_unit_count", "role_in_group", "purpose", "viewer_takeaway", "cut_role", "visual_summary", "image_prompt"],
      "properties": {
        "source_unit_count": {"type": "integer", "minimum": 1, "maximum": 300},
        "role_in_group": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1},
        "viewer_takeaway": {"type": "string", "minLength": 1},
        "cut_role": {"type": "string", "enum": ["setup", "derived", "bridge", "evidence", "reaction", "detail", "transition", "payoff"]},
        "visual_summary": {"type": "string", "minLength": 1}, "image_prompt": {"type": "string", "minLength": 1}
      }
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["role_in_sequence", "purpose", "setup", "payoff", "scenes"],
      "properties": {
        "role_in_sequence": {"type": "string", "enum": ["introduce", "explain", "evidence", "example", "contrast", "deepen", "transition", "payoff", "recap", "other"]},
        "purpose": {"type": "string", "minLength": 1}, "setup": {"type": "string", "minLength": 1}, "payoff": {"type": "string", "minLength": 1},
        "scenes": {"type": "array", "minItems": 1, "maxItems": 300, "items": {"$ref": "#/$defs/scene"}}
      }
    },
    "sequence": {
      "type": "object", "additionalProperties": false,
      "required": ["role_in_story", "purpose", "viewer_state_before", "viewer_state_after", "keycut_scene_number", "keycut_dna", "scene_groups"],
      "properties": {
        "role_in_story": {"type": "string", "enum": ["hook", "setup", "problem", "development", "escalation", "turning_point", "explanation", "application", "resolution", "outro", "other"]},
        "purpose": {"type": "string", "minLength": 1}, "viewer_state_before": {"type": "string", "minLength": 1},
        "viewer_state_after": {"type": "string", "minLength": 1},
        "keycut_scene_number": {"type": "integer", "minimum": 1, "maximum": 300},
        "keycut_dna": {"$ref": "#/$defs/keycutDna"},
        "scene_groups": {"type": "array", "minItems": 1, "maxItems": 300, "items": {"$ref": "#/$defs/group"}}
      }
    },
    "continuityAsset": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "name", "canonical_identity", "must_remain_consistent", "allowed_variations", "states", "appearing_scene_numbers", "reference_scene_numbers", "selection_reason_code", "selection_reason", "failure_if_inconsistent", "confidence", "anchor_prompt"],
      "properties": {
        "category": {"type": "string", "enum": ["character", "object", "location", "vehicle", "graphic", "phenomenon"]},
        "name": {"type": "string", "minLength": 1}, "canonical_identity": {"type": "string", "minLength": 1},
        "must_remain_consistent": {"type": "array", "items": {"type": "string"}}, "allowed_variations": {"type": "array", "items": {"type": "string"}},
        "states": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["state_id", "description"], "properties": {"state_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}, "description": {"type": "string", "minLength": 1}}}},
        "appearing_scene_numbers": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 300}},
        "reference_scene_numbers": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 300}},
        "selection_reason_code": {"type": "string", "minLength": 1}, "selection_reason": {"type": "string", "minLength": 1},
        "failure_if_inconsistent": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "anchor_prompt": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 120}, "core_question": {"type": "string", "minLength": 1},
    "thesis": {"type": "string", "minLength": 1}, "audience_start_state": {"type": "string", "minLength": 1},
    "audience_end_state": {"type": "string", "minLength": 1},
    "master_keycut_sequence_number": {"type": "integer", "minimum": 1, "maximum": 300},
    "style_bible": {"$ref": "#/$defs/styleBible"},
    "sequences": {"type": "array", "minItems": 1, "maxItems": 300, "items": {"$ref": "#/$defs/sequence"}},
    "continuity_assets": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/continuityAsset"}},
    "rejected_borderline_candidates": {"type": "array", "maxItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["name", "reason_code"], "properties": {"name": {"type": "string", "minLength": 1}, "reason_code": {"type": "string", "minLength": 1}}}}
  }
}

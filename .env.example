# Docker Compose settings. Copy to .env in this directory.
POSTGRES_DB=slidegen
POSTGRES_USER=slidegen
POSTGRES_PASSWORD=change-this-on-mini
API_PORT=3000
WEB_PORT=8080
CORS_ORIGIN=
WORKER_CONCURRENCY=1
VIDEO_JOB_GLOBAL_CONCURRENCY=1
USER_PENDING=20
GLOBAL_PENDING=20
DAILY_JOBS=0
JOB_TIMEOUT_MINUTES=90
JOB_RETENTION_HOURS=720
USD_KRW_RATE=1388.1

# mock: no paid or subscription provider calls. live: Codex + OAuth images + ElevenLabs.
RUNNER_MODE=mock
IMAGE_PROVIDER=mock
VOICE_PROVIDER=mock
MICROSOFT_EDGE_VOICE=ko-KR-InJoonNeural
MICROSOFT_EDGE_RATE=-30%
MICROSOFT_EDGE_PITCH=+0Hz
MICROSOFT_EDGE_VOLUME=+0%
SOURCE_REVISION=working-tree
RUNNER_IMAGE_DIGEST=unavailable
CODEX_HOME_DIR=./.runtime/codex
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=max
CODEX_FAST_MODE=false
CODEX_MODEL_OPTIONS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
CODEX_READ_TIMEOUT_SECONDS=300
CODEX_CONNECT_TIMEOUT_SECONDS=10
RUNNER_IMAGE_GENERATION_MODEL=gpt-image-2.5-sunburst
IMAGE_TASK_CONCURRENCY=12
VOICE_TASK_CONCURRENCY=2
FFMPEG_TASK_CONCURRENCY=1
VIDEO_FPS=24
